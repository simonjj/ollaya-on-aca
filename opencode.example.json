{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollaya-aca/ollaya-auto",
  "provider": {
    "ollaya-aca": {
      "npm": "@ai-sdk/openai",
      "name": "Ollaya router on Azure Container Apps",
      "options": {
        "baseURL": "{env:OLLAYA_ROUTER_ENDPOINT}/v1",
        "apiKey": "{env:OLLAYA_ROUTER_API_KEY}"
      },
      "models": {
        "ollaya-auto": {
          "name": "Ollaya automatic routing",
          "limit": {
            "context": 922000,
            "output": 128000
          }
        },
        "ollaya-baseline": {
          "name": "GPT-5.6 Sol high reasoning baseline",
          "limit": {
            "context": 922000,
            "output": 128000
          }
        }
      }
    }
  }
}
